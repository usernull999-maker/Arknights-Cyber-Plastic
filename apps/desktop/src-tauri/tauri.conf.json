{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arknights Super",
  "version": "0.1.0",
  "identifier": "com.arknights.super",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TIME",
        "width": 404,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../resources/ocr/rec/inference.onnx": "ocr/rec/inference.onnx",
      "../../../resources/ocr/rec/keys.txt": "ocr/rec/keys.txt",
      "../../../resources/ocr/tasks/tasks.json": "ocr/tasks/tasks.json"
    },
    "icon": ["icons/icon.ico"]
  }
}
